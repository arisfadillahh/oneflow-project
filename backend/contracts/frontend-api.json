{
  "schemaVersion": 1,
  "name": "oneflow-frontend-api-reference",
  "sourceRepository": "oneflow-backend",
  "sourceCommit": "ccf812c14fb9d7cd26348d82bce956feb9724b59",
  "owner": "apps/app-backend",
  "consumer": "oneflow-frontend",
  "lastUpdated": "2026-05-30",
  "boundary": {
    "browserMayCall": "app-backend HTTP API and /ws only",
    "browserMustNotCall": [
      "ai-service",
      "wa-gateway internal routes",
      "database",
      "redis",
      "worker",
      "/api/internal/*",
      "/api/payments/midtrans/notification"
    ],
    "aiRuntimeAccess": "app-backend owns calls to ai-service so tenant isolation, AI credit billing, ai_runs, and guardrails are preserved.",
    "waGatewayAccess": "Frontend controls WhatsApp through app-backend /api/whatsapp/* routes. Do not call wa-gateway directly from browser code."
  },
  "baseUrls": {
    "local": "http://localhost:8080",
    "production": "https://oneflow.id",
    "websocketLocal": "ws://localhost:8080/ws",
    "websocketProduction": "wss://oneflow.id/ws"
  },
  "frontendEnvironment": {
    "NEXT_PUBLIC_API_BASE_URL": "Optional browser API base. Empty means same-origin proxy in production and localhost:8080 on local loopback.",
    "NEXT_PUBLIC_WS_BASE_URL": "Optional browser WebSocket base. Empty means same-origin /ws in production and localhost:8080/ws on local loopback.",
    "NEXT_PUBLIC_WA_GATEWAY_URL": "Optional legacy gateway base. Prefer app-backend APIs for new work.",
    "API_PROXY_TARGET": "Server-side Next.js rewrite target for /api/* and /health."
  },
  "auth": {
    "scheme": "Bearer JWT",
    "header": "Authorization: Bearer <token>",
    "tokenTtl": "12h",
    "loginEndpoint": "POST /api/auth/login",
    "registerEndpoint": "POST /api/auth/register",
    "tokenResponsePath": "$.token",
    "userResponsePath": "$.user"
  },
  "responseConventions": {
    "success": "Most list responses use { items: [...] }. Mutations usually return { status: \"ok\", id?: string }.",
    "error": "{ \"error\": \"human readable message\" }",
    "commonStatusCodes": {
      "200": "Success",
      "400": "Invalid request or validation error",
      "401": "Missing or invalid token",
      "402": "Plan/credit/capacity requirement not met",
      "403": "Role or organization access denied",
      "404": "Route or resource not found",
      "409": "Conflict or unsupported state transition",
      "429": "Rate limited",
      "500": "Server error",
      "502": "Upstream service error"
    }
  },
  "roles": [
    "owner",
    "super_admin",
    "admin",
    "operator"
  ],
  "routeFamilies": [
    { "id": "health", "auth": "public", "pathPattern": "^/(health|healthz)$" },
    { "id": "public-billing", "auth": "public-read", "pathPattern": "^/api/public/billing(?:/.*)?$" },
    { "id": "auth", "auth": "public-login-register", "pathPattern": "^/api/auth(?:/.*)?$" },
    { "id": "account", "auth": "required", "pathPattern": "^/api/account(?:/.*)?$" },
    { "id": "organizations", "auth": "required", "pathPattern": "^/api/organizations(?:/.*)?$" },
    { "id": "team", "auth": "required", "pathPattern": "^/api/team(?:/.*)?$" },
    { "id": "dashboard", "auth": "required", "pathPattern": "^/api/dashboard(?:/.*)?$" },
    { "id": "analytics", "auth": "required", "pathPattern": "^/api/analytics(?:/.*)?$" },
    { "id": "system", "auth": "owner-or-admin", "pathPattern": "^/api/system(?:/.*)?$" },
    { "id": "ai-config", "auth": "required", "pathPattern": "^/api/(agents|ai-agents|ai-settings|ai-models|ai-runs)(?:/.*)?$" },
    { "id": "playground", "auth": "required", "pathPattern": "^/api/playground(?:/.*)?$" },
    { "id": "knowledge", "auth": "required", "pathPattern": "^/api/(knowledge|knowledge-download|job-positions)(?:/.*)?$" },
    { "id": "inbox", "auth": "required", "pathPattern": "^/api/(inbox|conversations)(?:/.*)?$" },
    { "id": "contacts", "auth": "required", "pathPattern": "^/api/(contacts|contact-tags|follow-up-tasks|message-templates|broadcasts)(?:/.*)?$" },
    { "id": "business-tools", "auth": "required", "pathPattern": "^/api/business-tools(?:/.*)?$" },
    { "id": "commerce", "auth": "required", "pathPattern": "^/api/commerce(?:/.*)?$" },
    { "id": "booking", "auth": "required", "pathPattern": "^/api/booking(?:/.*)?$" },
    { "id": "deals", "auth": "required", "pathPattern": "^/api/(deals|deal-pipelines|deal-stages|deal-activities)(?:/.*)?$" },
    { "id": "tickets", "auth": "required", "pathPattern": "^/api/tickets(?:/.*)?$" },
    { "id": "billing", "auth": "required", "pathPattern": "^/api/billing(?:/.*)?$" },
    { "id": "whatsapp", "auth": "required", "pathPattern": "^/api/whatsapp(?:/.*)?$" },
    { "id": "notifications", "auth": "required", "pathPattern": "^/api/(notifications|group-notification-rules|escalation-group)(?:/.*)?$" },
    { "id": "support", "auth": "required", "pathPattern": "^/api/support(?:/.*)?$" },
    { "id": "dev", "auth": "local-dev-only", "pathPattern": "^/api/dev(?:/.*)?$" },
    { "id": "internal", "auth": "internal-token", "frontendCallable": false, "pathPattern": "^/api/internal(?:/.*)?$" },
    { "id": "payment-webhook", "auth": "provider-webhook", "frontendCallable": false, "pathPattern": "^/api/payments/midtrans/notification$" }
  ],
