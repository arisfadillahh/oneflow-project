  "requestSchemas": {
    "LoginRequest": {
      "username": "string",
      "password": "string"
    },
    "RegisterRequest": {
      "name": "string",
      "username": "string",
      "password": "string, min 8 chars",
      "phone": "string optional",
      "organizationName": "string",
      "organizationSlug": "string optional, derived from organizationName when empty"
    },
    "AcceptInviteRequest": {
      "token": "string",
      "name": "string optional",
      "password": "string"
    },
    "AgentRequest": {
      "name": "string",
      "username": "string",
      "role": "owner | super_admin | admin | operator",
      "status": "active | inactive",
      "password": "string optional on create/update"
    },
    "AIAgentRequest": {
      "name": "string",
      "modelTier": "basic | advance",
      "modelName": "OpenRouter model id or owner alias",
      "systemPrompt": "string",
      "fallbackWaitingMessage": "string optional",
      "sourceOfTruth": "string optional",
      "escalationRule": "string optional",
      "customerMemoryEnabled": "boolean optional",
      "customerMemoryLlmValidatorEnabled": "boolean optional"
    },
    "AISettingsRequest": {
      "modelAliases": "object optional",
      "availableModelIds": "string[] optional"
    },
    "PlaygroundRunRequest": {
      "aiAgentId": "string",
      "customerName": "string optional",
      "messageText": "string",
      "history": "array optional"
    },
    "CommerceProductRequest": {
      "sku": "string optional",
      "name": "string",
      "description": "string optional",
      "unitPrice": "number",
      "stockQuantity": "integer",
      "lowStockThreshold": "integer optional",
      "status": "active | inactive optional"
    },
    "CommerceOrderStageRequest": {
      "pipelineId": "string",
      "name": "string",
      "position": "integer optional",
      "type": "draft | confirmed | cancelled | fulfilled or local stage type",
      "color": "string optional"
    },
    "CommerceOrderDraftRequest": {
      "contactId": "string optional",
      "conversationId": "string optional",
      "customerName": "string optional",
      "customerPhone": "string optional",
      "stageId": "string optional",
      "status": "string optional",
      "source": "string optional",
      "notes": "string optional",
      "fulfillmentType": "pickup | delivery | digital optional",
      "recipientName": "string optional",
      "recipientPhone": "string optional",
      "addressLine": "string optional",
      "addressArea": "string optional",
      "addressNotes": "string optional",
      "items": [
        {
          "productId": "string",
          "quantity": "integer",
          "unitPrice": "number optional"
        }
      ]
    },
    "BookingServiceRequest": {
      "name": "string",
      "description": "string optional",
      "durationMinutes": "integer",
      "bufferMinutes": "integer optional",
      "price": "number optional",
      "timezone": "IANA timezone string",
      "availability": "object",
      "status": "active | inactive"
    },
    "BookingAppointmentRequest": {
      "serviceId": "string",
      "contactId": "string optional",
      "conversationId": "string optional",
      "customerName": "string",
      "customerPhone": "string optional",
      "scheduledStart": "ISO datetime string",
      "status": "draft | confirmed | cancelled | completed",
      "source": "string optional",
      "notes": "string optional",
      "locationType": "online | onsite | customer_address optional",
      "locationAddress": "string optional",
      "locationNotes": "string optional"
    },
    "DealRequest": {
      "title": "string",
      "contactId": "string optional",
      "conversationId": "string optional",
      "pipelineId": "string optional",
      "stageId": "string optional",
      "valueAmount": "integer optional",
      "currency": "string optional",
      "status": "open | won | lost optional",
      "priority": "low | medium | high optional",
      "ownerAgentId": "string optional",
      "expectedCloseDate": "YYYY-MM-DD optional",
      "source": "string optional",
      "notes": "string optional",
      "lossReason": "string optional"
    },
    "DealActivityRequest": {
      "type": "note | call | task | meeting | message",
      "title": "string",
      "body": "string optional",
      "dueAt": "ISO datetime optional",
      "done": "boolean optional",
      "assignedToId": "string optional"
    },
    "DealStageRequest": {
      "pipelineId": "string",
      "name": "string",
      "probability": "integer 0-100 optional",
      "position": "integer optional",
      "type": "open | won | lost optional",
      "color": "string optional"
    },
    "TicketRequest": {
      "title": "string optional on patch",
      "description": "string optional",
      "issueType": "complaint | product_question | payment | delivery | booking | technical | refund | other",
      "status": "new | triage | in_progress | waiting_customer | waiting_internal | resolved | closed | cancelled",
      "stageId": "string optional",
      "priority": "low | medium | high | urgent optional",
      "severity": "low | medium | high | critical optional",
      "contactId": "string optional",
      "conversationId": "string optional",
      "assignedToId": "string optional",
      "source": "string optional",
      "slaDueAt": "ISO datetime optional",
      "metadata": "object optional"
    },
    "BillingPackageRequest": {
      "name": "string",
      "description": "string optional",
      "creditAmount": "integer",
      "price": "number",
      "maxWhatsAppSessions": "integer",
      "maxAiAgents": "integer",
      "maxHumanUsers": "integer",
      "billingPeriod": "monthly | one_time",
      "isActive": "boolean optional on update",
      "isPopular": "boolean"
    },
    "PricingRequest": {
      "creditUnitIdr": "number",
      "usdToIdrRate": "number",
      "chatModelName": "string",
      "chatInputPricePer1m": "number",
      "chatOutputPricePer1m": "number",
      "embeddingModelName": "string",
      "embeddingPricePer1m": "number",
      "annualDiscountPercent": "number",
      "modelAliases": "object optional",
      "availableModelIds": "string[] optional"
    }
  },
  "costNotes": {
    "freeInsideOneflowCredits": [
      "Manual CRUD for CRM, tickets, commerce, booking, knowledge, team, and settings",
      "WhatsApp session status/QR/connect/disconnect actions except external provider fees"
    ],
    "billedByOneflowCredits": [
      "POST /api/playground/run",
      "POST /api/tickets/ai/triage",
      "WhatsApp inbound AI replies after app-backend calls ai-service"
    ],
    "externalProviderCost": [
      "Meta approved template send after 24-hour customer-service window",
      "Midtrans payment fees"
    ]
  },
  "frontendRules": [
    "Always send JSON requests with Content-Type: application/json unless endpoint says multipart/form-data.",
    "Keep API navigation relative or env-derived. Do not hardcode https://oneflow.id/dashboard.",
    "Never expose OpenRouter, internal gateway, database, or ai-service credentials in browser code.",
    "When a request can consume credits, show a user-facing cost hint before triggering it.",
    "For Meta follow-up: free-form WhatsApp replies are allowed only inside the 24-hour window; after that use approved templates and show that Meta/BSP charges are separate from Oneflow credits."
  ]
}
