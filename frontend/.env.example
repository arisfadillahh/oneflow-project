NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_NAME=oneflow.id

# Browser API target. Empty keeps production same-origin /api and local loopback at http://localhost:8080.
NEXT_PUBLIC_API_BASE_URL=

# Browser websocket target. Empty keeps production same-origin /ws and local loopback at ws://localhost:8080/ws.
NEXT_PUBLIC_WS_BASE_URL=

# Optional legacy direct WA gateway base. Prefer app-backend APIs for new frontend work.
NEXT_PUBLIC_WA_GATEWAY_URL=

# Server-side Next.js proxy target for /api/* and /health rewrites.
API_PROXY_TARGET=http://localhost:8080
